{
  "manifest_version": 3,
  "name": "Keel",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "description": "See and control how YouTube recommends videos to you.",
  "permissions": [
    "sidePanel",
    "storage",
    "nativeMessaging",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.tiktok.com/*"
      ],
      "js": [
        "content/bootstrap.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/observer.js",
        "content/extract.js",
        "content/extract_yt.js",
        "content/hide.js",
        "lib/selectors.js",
        "lib/prefs.js",
        "lib/browser.js",
        "lib/errors.js",
        "lib/protocol.js"
      ],
      "matches": [
        "*://www.youtube.com/*",
        "*://www.tiktok.com/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Keel"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
