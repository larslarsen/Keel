{"manifest_version": 3,"name": "Audit Bridge for YouTube","version": "1.0.0","description": "A productivity dashboard for YouTube that allows users to manage their viewing experience via a native side panel.","permissions": ["sidePanel","nativeMessaging","storage"],"host_permissions": ["://www.youtube.com/watch","://www.youtube.com/results"],"side_panel": {"default_path": "sidepanel.html"},"background": {"service_worker": "background.js"},"action": {"default_title": "Open Audit Dashboard"},"content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"},"minimum_chrome_version": "114"}
